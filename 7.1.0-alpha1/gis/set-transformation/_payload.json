ions of the NetLogo world:",[63,95,96],{},[66,97,98,99,47,104,47,109,47,113,47,117,121,122,98,125,47,128,47,132,47,136,47,140,121],{},"(",[38,100,103],{"className":101},[72,102],"reporter","list",[38,105,108],{"className":106},[72,107],"number","-180",[38,110,112],{"className":111},[72,107],"180",[38,114,116],{"className":115},[72,107],"-90",[38,118,120],{"className":119},[72,107],"90",")",[123,124],"br",{},[38,126,103],{"className":127},[72,102],[38,129,131],{"className":130},[72,102],"min-pxcor",[38,133,135],{"className":134},[72,102],"max-pxcor",[38,137,139],{"className":138},[72,102],"min-pycor",[38,141,143],{"className":142},[72,102],"max-pycor",[52,145,146,147,160],{},"However, if you’re setting the envelope of the NetLogo world,\nyou should probably be using ",[148,149,152],"primitive",{"displayText":150,"permalink":151},"gis:set-world-envelope","gis",[22,153,150],{"className":154,"dataDisplayText":150,"href":156,"rel":157,"target":159,"title":150},[155],"netlogo-wiki-link","/gis#set-world-envelope",[158],"noopener","_self",".",{"title":162,"searchDepth":163,"depth":164,"links":165},"",5,3,[166],{"id":19,"depth":164,"text":167,"children":168},"\n    gis:set-transformation\n  ",[169],{"id":29,"depth":170,"text":171},4,"\n    gis:set-transformation gis-envelope netlogo-envelope\n  ","Documentation for the set-transformation primitive.","md",{"source":175,"metadataOutputPath":176,"projectConfig":177,"language":184,"inheritFrom":192,"output":191,"version":178,"layout":193,"dictionaryDisplayName":194,"dictionaryHomeDirectory":195,"indexFileURI":196,"currentItemId":14,"currentItemLabel":25,"primRoot":151,"netlogoUrl":197,"icon":198,"extensionName":199,"assetsRoot":179},"../../external/extensions/gis/gis/set-transformation.md","content/gis/set-transformation.metadata.yaml",{"version":178,"projectRoot":160,"scanRoot":179,"outputRoot":180,"defaults":181,"engine":187,"partials":188,"dedupeIdenticalDiskWrites":191},"7.1.0-alpha1","/home/jason/Desktop/Development/NetLogo