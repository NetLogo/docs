[{"data":1,"prerenderedAt":269},["ShallowReactive",2],{"/dict/import":3,"/dict/import-surround":258},{"id":4,"title":5,"body":6,"description":225,"extension":226,"meta":227,"navigation":245,"path":254,"seo":255,"stem":256,"__hash__":257},"content/dict/import.md","NetLogo Dictionary: import",{"type":7,"value":8,"toc":214},"minimark",[9],[10,11,16,35,76,84,87,101,112,115,133,142,145,168,177,180,208],"div",{"className":12,"id":14,"role":15},[13],"dict_entry","import","region",[17,18,20],"h3",{"id":19},"import71",[21,22,26,27],"a",{"href":23,"role":24,"ariaLabel":25},"#import","doc-noteref","Reference to import","\nimport\n",[28,29,34],"span",{"className":30,"role":32,"ariaLabel":33},[31],"since","note","Since version","\n7.1\n",[36,37,41],"h4",{"id":38,"className":39},"import-module-as-prefiximport-names-from-module",[40],"section-heading",[21,42,46,62],{"className":43,"href":45},[44],"section-anchor","#import-module-as-prefiximport--names-from-module",[28,47,50],{"className":48},[49],"prim_example",[51,52,53,54,58,59],"p",{},"import ",[55,56,57],"em",{},"module"," as ",[55,60,61],{},"prefix",[28,63,65],{"className":64},[49],[51,66,53,67,73,74],{},[28,68,69,70],{}," ",[55,71,72],{},"names"," from ",[55,75,57],{},[51,77,78,79,83],{},"Make the procedures in the given module available for use in the\ncurrent file. The file name of the module file (with the ",[80,81,82],"code",{},".nlm"," suffix)\nmust be a valid NetLogo name, so there can be no space in the name.",[51,85,86],{},"For example:",[88,89,90],"pre",{},[80,91,92,69,97],{},[28,93,14],{"className":94},[95,96],"token","variable",[28,98,100],{"className":99},[95,96],"utils",[51,102,103,104,107,108,111],{},"This will import procedures in “utils.nls” in the same directory as the\ncurrent file and make them available with a “utils:” prefix. As an example,\nif there is a reporter called ",[80,105,106],{},"add"," in “utils.nls”, then it will be made\navailable for use under the name ",[80,109,110],{},"utils:add",".",[51,113,114],{},"The prefix can be changed as follows:",[88,116,117],{},[80,118,119,69,122,69,125,69,129],{},[28,120,14],{"className":121},[95,96],[28,123,100],{"className":124},[95,96],[28,126,128],{"className":127},[95,96],"as",[28,130,132],{"className":131},[95,96],"u",[51,134,135,136,138,139,111],{},"This will instead make ",[80,137,106],{}," available as ",[80,140,141],{},"u:add",[51,143,144],{},"It is also possible to selectively import a subset of procedures or\nreporters from a module, for example:",[88,146,147],{},[80,148,149,152,153,69,156,160,161,69,165],{},[28,150,14],{"className":151},[95,96]," [",[28,154,106],{"className":155},[95,96],[28,157,159],{"className":158},[95,96],"subtract","] ",[28,162,164],{"className":163},[95,96],"from",[28,166,100],{"className":167},[95,96],[51,169,170,171,173,174,176],{},"This will make ",[80,172,106],{}," and ",[80,175,159],{}," available in the current file. Note\nthat no prefix is added when a module is imported this way.",[51,178,179],{},"Imported procedures and reporters can be renamed as follows:",[88,181,182],{},[80,183,184,152,187,190,191,69,194,69,197,201,202,69,205],{},[28,185,14],{"className":186},[95,96],[28,188,106],{"className":189},[95,96]," (",[28,192,159],{"className":193},[95,96],[28,195,128],{"className":196},[95,96],[28,198,200],{"className":199},[95,96],"sub",")] ",[28,203,164],{"className":204},[95,96],[28,206,100],{"className":207},[95,96],[51,209,135,210,138,212,111],{},[80,211,159],{},[80,213,200],{},{"title":215,"searchDepth":216,"depth":217,"links":218},"",5,3,[219],{"id":19,"depth":217,"text":220,"children":221},"\nimport\n\n7.1\n",[222],{"id":38,"depth":223,"text":224},4,"import module as prefiximport  names from module","Documentation for the import primitive.","md",{"source":228,"metadataOutputPath":229,"projectConfig":230,"language":237,"inheritFrom":246,"output":245,"version":231,"layout":247,"dictionaryDisplayName":248,"dictionaryHomeDirectory":249,"indexFileURI":250,"currentItemId":14,"cur