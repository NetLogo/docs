e","] [ ",[28,138,14],{"className":139},[77,78],[101,141],{},[28,143,145],{"className":144},[77,106],";; all the blue links will die",[49,147,148],{},"A dead agent ceases to exist. The effects of this include:",[150,151,152,178,181,227,230],"ul",{},[153,154,155,156,177],"li",{},"The agent will not execute any further code. So if you write ",[72,157,158,80,161,95,165,80,168,80,172,99],{},[28,159,113],{"className":160},[77,78],[28,162,164],{"className":163},[77,84],"turtles",[28,166,14],{"className":167},[77,78],[28,169,171],{"className":170},[77,78],"print",[28,173,176],{"className":174},[77,175],"string","\"last words?\"",", no last\nwords will be printed, because the turtles are already dead before\nthey have a chance to print anything.",[153,179,180],{},"The agent will disappear from any agentsets it was in, reducing\nthe size of those agentsets by one.",[153,182,183,184,187,188,223,224,226],{},"Any variable that was storing the agent will now instead have ",[72,185,186],{},"nobody"," in it. So for example ",[72,189,190,80,194,80,199,80,203,80,206,209,210,95,213,216,217,80,220],{},[28,191,193],{"className":192},[77,78],"let",[28,195,198],{"className":196},[77,197],"variable","x",[28,200,202],{"className":201},[77,84],"one-of",[28,204,164],{"className":205},[77,84],[28,207,113],{"className":208},[77,78],"\n ",[28,211,198],{"className":212},[77,197],[28,214,14],{"className":215},[77,78]," ] ",[28,218,171],{"className":219},[77,78],[28,221,198],{"className":222},[77,197]," prints ",[72,225,186],{},".",[153,228,229],{},"If the dead agent was a turtle, every link connected to it also\ndies.",[153,231,232,233,236],{},"If the observer was watching or following the agent, the\nobserver’s perspective resets, as if ",[72,234,235],{},"reset-perspective","had been run.",[49,238,239,240,80,252],{},"See also: ",[241,242,244],"primitive",{"displayText":243,"permalink":243},"clear-turtles",[21,245,243],{"className":246,"dataDisplayText":243,"href":248,"rel":249,"target":251,"titl