[{"data":1,"prerenderedAt":196},["ShallowReactive",2],{"/gis/sampling-method-of":3,"/gis/sampling-method-of-surround":185},{"id":4,"title":5,"body":6,"description":152,"extension":153,"meta":154,"navigation":171,"path":181,"seo":182,"stem":183,"__hash__":184},"content/gis/sampling-method-of.md","GIS Extension Dictionary: sampling-method-of",{"type":7,"value":8,"toc":141},"minimark",[9],[10,11,15,16,15,26,47,91,132],"div",{"className":12,"id":14},[13],"dict_entry","sampling-method-of","\n  ",[17,18,20,21,15],"h3",{"id":19},"gissampling-method-of","\n    ",[22,23,25],"a",{"href":24},"#sampling-method-of","gis:sampling-method-of",[27,28,32],"h4",{"id":29,"className":30},"gissampling-method-of-raster-dataset",[31],"section-heading",[22,33,20,37,15],{"className":34,"href":36},[35],"section-anchor","#----gissampling-method-of-raster-dataset--",[38,39,42,43],"span",{"className":40},[41],"prim_example","gis:sampling-method-of ",[44,45,46],"i",{},"raster-dataset",[48,49,50,51,64,65,64,73,81,82,90],"p",{},"Reports the sampling method used to compute the value of the given\nraster dataset at a single point, or over an area smaller than a\nsingle raster cell. Sampling is performed by the GIS extension\nprimitives ",[52,53,56],"primitive",{"displayText":54,"permalink":55},"gis:raster-sample","gis",[22,57,54],{"className":58,"dataDisplayText":54,"href":60,"rel":61,"target":63,"title":54},[59],"netlogo-wiki-link","/gis#raster-sample",[62],"noopener","_self",", ",[52,66,68],{"displayText":67,"permalink":55},"gis:resample",[22,69,67],{"className":70,"dataDisplayText":67,"href":71,"rel":72,"target":63,"title":67},[59],"/gis#resample",[62],[52,74,76],{"displayText":75,"permalink":55},"gis:convolve",[22,77,75],{"className":78,"dataDisplayText":75,"href":79,"rel":80,"target":63,"title":75},[59],"/gis#convolve",[62],",\nand ",[52,83,85],{"displayText":84,"permalink":55},"gis:apply-raster",[22,86,84],{"className":87,"dataDisplayText":84,"href":88,"rel":89,"target":63,"title":84},[59],"/gis#apply-raster",[62],". The sampling\nmethod will be one of the following:",[92,93,94,102,108,119],"ul",{},[95,96,97,101],"li",{},[98,99,100],"code",{},"\"NEAREST_NEIGHBOR\"",": the value of the cell\nnearest the sampling location is used.",[95,103,104,107],{},[98,105,106],{},"\"BILINEAR\"",": the value of the four nearest\ncells are sampled by linear weighting, according to their\nproximity to the sampling site.",[95,109,110,113,114,118],{},[98,111,112],{},"\"BICUBIC\"",": the value of the sixteen nearest\ncells are sampled, and their values are combined by weight\naccording to a piecewise cubic polynomial recommended by Rifman\n(see ",[115,116,117],"em",{},"Digital Image Warping",", George Wolberg, 1990, pp\n129-131, IEEE Computer Society Press).",[95,120,121,124,125,128,129,131],{},[98,122,123],{},"\"BICUBIC_2\"",": the value is sampled using the\nsame procedure and the same polynomial as with ",[98,126,127],{},"BICUBIC","\nabove, but using a different coefficient. This method may produce\nsomewhat sharper results than ",[98,130,127],{},", but that result\nis data dependent.",[48,133,134,135,140],{},"For more information on these sampling methods and on raster\nsampling in general, see ",[22,136,139],{"href":137,"target":138},"https://en.wikipedia.org/wiki/Image_scaling","_blank","this wikipedia\narticle",".",{"title":142,"searchDepth":143,"depth":144,"links":145},"",5,3,[146],{"id":19,"depth":144,"text":147,"children":148},"\n    gis:sampling-method-of\n  ",[149],{"id":29,"depth":150,"text":151},4,"\n    gis:sampling-method-of raster-dataset\n  ","Documentation for the sampling-method-of primitive.","md",{"source":155,"metadataOutputPath":156,"projectConfig":157,"language":164,"inheritFrom":172,"output":171,"version":158,"layout":173,"dictionaryDisplayName":174,"dictionaryHomeDirectory":175,"indexFileURI":176,"currentItemId":14,"currentItemLabel":25,"primRoot":55,"netlogoUrl":177,"icon":178,"extensionName":179,"assetsRoot":159},"../../external/extensions/gis/gis/sampling-method-of.md","content/gis/sampling-method-of.metadata.yaml",{"version":158,"projectRoot":140,"scanRoot":159,"outputRoot":160,"defaults":161,"engine":167,"partials":168,"dedupeIdenticalDiskWrites":171},"7.0.4","/home/runner/work/Helio/Helio/external/extensions/gis","content",{"inheritFrom":162,"language":164,"output":165,"extension":153,"title":166,"version":158},[163],0,"en",false,"NetLogo User Manual","mustache",{"directoryPaths":169,"extensions":170},[140],[167,153],true,[163],"catalog","GIS Extension Dictionary","/gis.html","/_index/extensions/gis.txt","http://ccl.northwestern.edu/netlogo/docs/","i-lucide-map-pin",{"shortName":55,"fullName":180},"GIS","/gis/sampling-method-of",{"title":5,"description":152},"gis/sampling-method-of","VN54mWjJEkAVj-T_07UGGLphPjFUIPasibBT2rWPn2M",[186,191],{"title":187,"path":188,"stem":189,"description":190,"children":-1},"GIS Extension Dictionary: resample","/gis/resample","gis/resample","Documentation for the resample primitive.",{"title":192,"path":193,"stem":194,"description":195,"children":-1},"GIS Extension Dictionary: set-coordinate-system","/gis/set-coordinate-system","gis/set-coordinate-system","Documentation for the set-coordinate-system primitive.",1778864653552]