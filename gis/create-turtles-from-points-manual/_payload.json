82,83,47,89,93,94,47,97,100,101,106],{},"[[",[38,84,88],{"className":85},[86,87],"token","string","\"property-name\"",[38,90,92],{"className":91},[86,87],"\"turtle-variable-name\"","] [",[38,95,88],{"className":96},[86,87],[38,98,92],{"className":99},[86,87],"] (",[38,102,105],{"className":103},[86,104],"variable","etc.",")]",[58,108,109,110,117],{},"These manual mappings modify the automatic mapping process that takes\nplace in the ",[62,111,113],{"className":112,"displayText":66,"permalink":67},[65],[22,114,66],{"className":115,"dataDisplayText":66,"href":72,"rel":116,"target":75,"title":66},[71],[74]," primitive, so you only need\nto specify the changes you want to make to the default mappings, and\nthe rest of the mappings will be untouched.",[58,119,120],{},"To return to the cities example from the\ncreate-turtles-from-points entry, the variable name “capital” is not very\ndescriptive. something like “is-capital?” fits the NetLogo style much better.\nTo make that change, you would modify the example like so.",[122,123,124],"pre",{},[62,125,126,131,132,135,136,131,142,47,146,135,150,131,156,47,160,47,164,47,168,135,172,131,178,135,182,184,47,190,194,196,197,47,202,47,205,47,209,213,196,215,220,196,222,47,225,47,228,231,232,47,236,240,241,243,244,47,247,47,252,256,258,259,196,261,265],{},[38,127,130],{"className":128},[86,129],"keyword","extensions"," [",[38,133,67],{"className":134},[86,104],"]",[38,137,139,50],{"className":138},[86,129],[140,141],"br",{},[38,143,145],{"className":144},[86,104],"cities",[38,147,149],{"className":148},[86,104],"city",[38,151,153,155],{"className":152},[86,129],[140,154],{},"cities-own",[38,157,159],{"className":158},[86,104],"name",[38,161,163],{"className":162},[86,104],"country",[38,165,167],{"className":166},[86,104],"population",[38,169,171],{"className":170},[86,104],"is-capital?",[38,173,175,177],{"className":174},[86,129],[140,176],{},"globals",[38,179,181],{"className":180},[86,104],"cities-dataset",[140,183],{},[38,185,187,189],{"className":186},[86,129],[140,188],{},"to",[38,191,193],{"className":192},[86,104],"setup",[140,195],{},"  ",[38,198,201],{"className":199},[86,200],"command","set",[38,203,181],{"className":204},[86,104],[38,206,208],{"className":207},[86,104],"gis:load-dataset",[38,210,212],{"className":211},[86,87],"\"cities.shp\"",[140,214],{},[38,216,219],{"className":217},[86,218],"comment",";; Since we only want to change how the \"CAPITAL\" property is mapped, we only need to specify that one change.",[140,221],{},[38,223,25],{"className":224},[86,104],[38,226,181],{"className":227},[86,104],[38,229,145],{"className":230},[86,104]," [[",[38,233,235],{"className":234},[86,87],"\"CAPITAL\"",[38,237,239],{"className":238},[86,87],"\"is-capital?\"","]] [",[140,242],{},"    ",[38,245,201],{"className":246},[86,200],[38,248,251],{"className":249},[86,250],"reporter","shape",[38,253,255],{"className":254},[86,87],"\"circle\"",[140,257],{},"  ]",[140,260],{},[38,262,264],{"className":263},[86,218],";; Each city turtle still has a name, country, and population set just like the non-manual version.",[38,266,268,270],{"className":267},[86,129],[140,269],{},"end",{"title":272,"searchDepth":273,"depth":274,"links":275},"",5,3,[276],{"id":19,"depth":274,"text":277,"children":278},"\n    gis:create-turtles-from-points-manual\n  ",[279],{"id":29,"depth":280,"text":281},4,"\n    gis:create-turtles-from-points-manual vector-dataset breed property-mapping commands\n  ","Documentation for the create-turtles-from-points-manual primitive.","md",{"source":285,"metadataOutputPath":286,"projectConfig":287,"language":295,"inheritFrom":303,"output":302,"version":288,"layout":304,"dictionaryDisplayName":305,"dictionaryHomeDirectory":306,"indexFileURI":307,"currentItemId":14,"currentItemLabel":25,"primRoot":67,"netlogoUrl":308,"icon":309,"extensionName":310,"assetsRoot":290},"../../external/extensions/gis/gis/create-turtles-from-points-manual.md","content/gis/create-turtles-from-points-manual.