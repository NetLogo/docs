[{"data":1,"prerenderedAt":122},["ShallowReactive",2],{"/nw/eigenvector-centrality":3,"/nw/eigenvector-centrality-surround":111},{"id":4,"title":5,"body":6,"description":78,"extension":79,"meta":80,"navigation":97,"path":107,"seo":108,"stem":109,"__hash__":110},"content/nw/eigenvector-centrality.md","Networks Extension Dictionary: eigenvector-centrality",{"type":7,"value":8,"toc":68},"minimark",[9],[10,11,15,16,15,26,42,53,62,65],"div",{"className":12,"id":14},[13],"dict_entry","eigenvector-centrality","\n  ",[17,18,20,21,15],"h3",{"id":19},"nweigenvector-centrality","\n    ",[22,23,25],"a",{"href":24},"#eigenvector-centrality","nw:eigenvector-centrality",[27,28,32],"h4",{"id":29,"className":30},"nweigenvector-centrality-1",[31],"section-heading",[22,33,20,37,15],{"className":34,"href":36},[35],"section-anchor","#----nweigenvector-centrality---1",[38,39,25],"span",{"className":40},[41],"prim_example",[43,44,45,46,52],"p",{},"The ",[22,47,51],{"href":48,"rel":49},"https://en.wikipedia.org/wiki/Centrality#Eigenvector_centrality",[50],"nofollow","Eigenvector centrality"," of a node can be thought of as the amount of influence a node has on a network. In practice, turtles that are connected to a lot of other turtles that are themselves well-connected (and so on) get a higher Eigenvector centrality score.",[43,54,55,56,61],{},"In this implementation, the eigenvector centrality is normalized such that the highest eigenvector centrality a node can have is 1. This implementation is designed to agree with Gephi’s implementation out to at least 3 decimal places. If you discover that it disagrees with Gephi on a particular network, please ",[22,57,60],{"href":58,"rel":59},"https://github.com/NetLogo/NW-Extension/issues/new",[50],"report it",".",[43,63,64],{},"The primitive respects link direction, even in mixed-directed networks. This is the one place where it should disagree with Gephi; Gephi refuses to treat directed links as directed in mixed-networks.",[43,66,67],{},"As of now, link weights are not taken into account.",{"title":69,"searchDepth":70,"depth":71,"links":72},"",5,3,[73],{"id":19,"depth":71,"text":74,"children":75},"\n    nw:eigenvector-centrality\n  ",[76],{"id":29,"depth":77,"text":74},4,"Documentation for the eigenvector-centrality primitive.","md",{"source":81,"metadataOutputPath":82,"projectConfig":83,"language":90,"inheritFrom":98,"output":97,"version":84,"layout":99,"dictionaryDisplayName":100,"dictionaryHomeDirectory":101,"indexFileURI":102,"currentItemId":14,"currentItemLabel":25,"primRoot":103,"icon":104,"extensionName":105,"assetsRoot":85},"../../external/extensions/nw/nw/eigenvector-centrality.md","content/nw/eigenvector-centrality.metadata.yaml",{"version":84,"projectRoot":61,"scanRoot":85,"outputRoot":86,"defaults":87,"engine":93,"partials":94,"dedupeIdenticalDiskWrites":97},"7.0.3","/Users/pas6148/Documents/netlogo/Helio/external/extensions/nw","content",{"inheritFrom":88,"language":90,"output":91,"extension":79,"title":92,"version":84},[89],0,"en",false,"NetLogo User Manual","mustache",{"directoryPaths":95,"extensions":96},[61],[93,79],true,[89],"catalog","Networks Extension Dictionary","/nw.html","/_index/extensions/nw.txt","nw","i-lucide-network",{"shortName":103,"fullName":106},"Networks","/nw/eigenvector-centrality",{"title":5,"description":78},"nw/eigenvector-centrality","z2ohvI49YxsUtEnselrybsZBM2bM_ErGjYXorHgVFcA",[112,117],{"title":113,"path":114,"stem":115,"description":116,"children":-1},"Networks Extension Dictionary: distance-to","/nw/distance-to","nw/distance-to","Documentation for the distance-to primitive.",{"title":118,"path":119,"stem":120,"description":121,"children":-1},"Networks Extension Dictionary: generate-lattice-2d","/nw/generate-lattice-2d","nw/generate-lattice-2d","Documentation for the generate-lattice-2d primitive.",1768246428538]