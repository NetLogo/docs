[{"data":1,"prerenderedAt":184},["ShallowReactive",2],{"/nw/load":3,"/nw/load-surround":173},{"id":4,"title":5,"body":6,"description":140,"extension":141,"meta":142,"navigation":159,"path":169,"seo":170,"stem":171,"__hash__":172},"content/nw/load.md","Networks Extension Dictionary: load",{"type":7,"value":8,"toc":129},"minimark",[9],[10,11,15,16,15,26,57,61,95,106,109,117],"div",{"className":12,"id":14},[13],"dict_entry","load","\n  ",[17,18,20,21,15],"h3",{"id":19},"nwload","\n    ",[22,23,25],"a",{"href":24},"#load","nw:load",[27,28,32],"h4",{"id":29,"className":30},"nwload-file-name-default-turtle-breed-default-link-breed-optional-command-block",[31],"section-heading",[22,33,20,37,15],{"className":34,"href":36},[35],"section-anchor","#----nwload-file-name-default-turtle-breed-default-link-breed-optional-command-block--",[38,39,42,43,47,48,47,51,47,54],"span",{"className":40},[41],"prim_example","nw:load ",[44,45,46],"i",{},"file-name"," ",[44,49,50],{},"default-turtle-breed",[44,52,53],{},"default-link-breed",[44,55,56],{},"optional-command-block",[58,59,60],"p",{},"Filetype specific variants:",[62,63,64,70,75,80,85,90],"ul",{},[65,66,67],"li",{},[68,69,25],"code",{},[65,71,72],{},[68,73,74],{},"nw:load-dl",[65,76,77],{},[68,78,79],{},"nw:load-gdf",[65,81,82],{},[68,83,84],{},"nw:load-gexf",[65,86,87],{},[68,88,89],{},"nw:load-gml",[65,91,92],{},[68,93,94],{},"nw:load-vna",[58,96,97,98,101,102,105],{},"Import the given file into NetLogo. Like ",[68,99,100],{},"nw:load-graphml",", the importer will do its best to match node and edge attributes in the file with turtle and link variables in NetLogo. If ",[68,103,104],{},"breed"," is specified for nodes and edges in the file and exists in NetLogo, it will be used. Otherwise, the default turtle and link breeds are used.",[58,107,108],{},"Limitations:",[62,110,111],{},[65,112,113,114,116],{},"Multigraphs are not supported in importing. Even if the file format supports it (and many don’t), only the first link will be used on import. This is due to a limitation in the parsing libraries NW uses. ",[68,115,100],{}," does support multigraphs with the normal NetLogo limitation that two turtles can share more than one link only if all the links are of different breeds.",[58,118,119,121,122,125,126,128],{},[68,120,25],{}," determines the file-type of given file based on the extension and calls the corresponding ",[68,123,124],{},"load-*"," primitive on it. Note that GraphML must be imported with ",[68,127,100],{},".",{"title":130,"searchDepth":131,"depth":132,"links":133},"",5,3,[134],{"id":19,"depth":132,"text":135,"children":136},"\n    nw:load\n  ",[137],{"id":29,"depth":138,"text":139},4,"\n    nw:load file-name default-turtle-breed default-link-breed optional-command-block\n  ","Documentation for the load primitive.","md",{"source":143,"metadataOutputPath":144,"projectConfig":145,"language":152,"inheritFrom":160,"output":159,"version":146,"layout":161,"dictionaryDisplayName":162,"dictionaryHomeDirectory":163,"indexFileURI":164,"currentItemId":14,"currentItemLabel":25,"primRoot":165,"icon":166,"extensionName":167,"assetsRoot":147},"../../external/extensions/nw/nw/load.md","content/nw/load.metadata.yaml",{"version":146,"projectRoot":128,"scanRoot":147,"outputRoot":148,"defaults":149,"engine":155,"partials":156,"dedupeIdenticalDiskWrites":159},"7.0.3","/Users/pas6148/Documents/netlogo/Helio/external/extensions/nw","content",{"inheritFrom":150,"language":152,"output":153,"extension":141,"title":154,"version":146},[151],0,"en",false,"NetLogo User Manual","mustache",{"directoryPaths":157,"extensions":158},[128],[155,141],true,[151],"catalog","Networks Extension Dictionary","/nw.html","/_index/extensions/nw.txt","nw","i-lucide-network",{"shortName":165,"fullName":168},"Networks","/nw/load",{"title":5,"description":140},"nw/load","wWxWH0gSyrCEBOptXiEQVI7Nsgznli_ILSY_6s8iij0",[174,179],{"title":175,"path":176,"stem":177,"description":178,"children":-1},"Networks Extension Dictionary: get-con