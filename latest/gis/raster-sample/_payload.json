[{"data":1,"prerenderedAt":288},["ShallowReactive",2],{"/gis/raster-sample":3,"/gis/raster-sample-surround":277},{"id":4,"title":5,"body":6,"description":243,"extension":244,"meta":245,"navigation":263,"path":273,"seo":274,"stem":275,"__hash__":276},"content/gis/raster-sample.md","GIS Extension Dictionary: raster-sample",{"type":7,"value":8,"toc":232},"minimark",[9],[10,11,15,16,15,26,51,55,115,118,219],"div",{"className":12,"id":14},[13],"dict_entry","raster-sample","\n  ",[17,18,20,21,15],"h3",{"id":19},"gisraster-sample","\n    ",[22,23,25],"a",{"href":24},"#raster-sample","gis:raster-sample",[27,28,32],"h4",{"id":29,"className":30},"gisraster-sample-raster-dataset-sample-location",[31],"section-heading",[22,33,20,37,15],{"className":34,"href":36},[35],"section-anchor","#----gisraster-sample-raster-dataset-sample-location--",[38,39,42,43,47,48],"span",{"className":40},[41],"prim_example","gis:raster-sample ",[44,45,46],"i",{},"raster-dataset"," ",[44,49,50],{},"sample-location",[52,53,54],"p",{},"Reports the value of the given raster over the given location. The\nlocation may be any of the following:",[56,57,58,93,106,109,112],"ul",{},[59,60,61,62,77,78,92],"li",{},"A list of length 2, which is taken to represent a point in\nnetlogo space (",[63,64,65,66,47,72,76],"code",{},"[",[38,67,71],{"className":68},[69,70],"token","reporter","xcor",[38,73,75],{"className":74},[69,70],"ycor","]",") of the sort reported by\n",[63,79,84],{"className":80,"displayText":82,"permalink":83},[81],"netlogo-command","gis:location-of","gis",[22,85,82],{"className":86,"dataDisplayText":82,"href":88,"rel":89,"target":91,"title":82},[87],"netlogo-wiki-link","/gis#location-of",[90],"noopener","_self"," Vertex. The raster\ndataset is sampled at the point of that location.",[59,94,95,96,105],{},"A list of length 4, which is taken to represent an envelope in\nGIS space, of the sort reported by ",[63,97,100],{"className":98,"displayText":99,"permalink":83},[81],"envelope-of",[22,101,99],{"className":102,"dataDisplayText":99,"href":103,"rel":104,"target":91,"title":99},[87],"/gis#envelope-of",[90],". The raster dataset is sampled\nover the area of that envelope.",[59,107,108],{},"A patch, in which case the raster dataset is sampled over the\narea of the patch.",[59,110,111],{},"A turtle, in which case the raster dataset is sampled at the\nlocation of that turtle.",[59,113,114],{},"A Vertex, in which case the raster dataset is sampled at the\nlocation of that Vertex.",[52,116,117],{},"If the requested location is outside the area covered by the raster\ndataset, this primitive reports the special value representing\n“not a number”, which is printed by NetLogo as\n“NaN”. Using the special “not a number” value\nas an argument to primitives that expect a number may cause an\nerror, but you can test the value reported by this primitive to\nfilter out “not a number” values. A value that is not a\nnumber will be neither less than nor greater than a number value,\nso you can detect “not a number” values using the\nfollowing:",[119,120,121],"pre",{},[63,122,123,47,128,47,133,47,136,47,140,47,144,149,152,157,159,163,164,47,167,47,171,174,175,163,179,47,182,47,186,189,190,192,193,47,197,47,201,206,207,192,209,47,212,47,215,206],{},[38,124,127],{"className":125},[69,126],"command","let",[38,129,132],{"className":130},[69,131],"variable","value",[38,134,25],{"className":135},[69,131],[38,137,139],{"className":138},[69,131],"dataset",[38,141,143],{"className":142},[69,70],"turtle",[38,145,148],{"className":146},[69,147],"number","0",[150,151],"br",{},[38,153,156],{"className":154},[69,155],"comment","; set color to blue if value is a number, red if value is \"not a number\"",[150,158],{},[38,160,162],{"className":161},[69,126],"ifelse"," (",[38,165,132],{"className":166},[69,131],[38,168,170],{"className":169},[69,70],"\u003C=",[38,172,148],{"className":173},[69,147],") ",[38,176,178],{"className":177},[69,70],"or",[38,180,132],{"className":181},[69,131],[38,183,185],{"className":184},[69,70],">=",[38,187,148],{"className":188},[69,147],")",[150,191],{},"[ ",[38,194,196],{"className":195},[69,126],"set",[38,198,200],{"className":199},[69,70],"color",[38,202,205],{"className":203},[69,204],"constant","blue"," ]",[150,208],{},[38,210,196],{"className":211},[69,126],[38,213,200],{"className":214},[69,70],[38,216,218],{"className":217},[69,204],"red",[52,220,221,222,231],{},"If the requested location is a point, the sample is always computed\nusing the method set by ",[63,223,226],{"className":224,"displayText":225,"permalink":83},[81],"gis:set-sampling-method",[22,227,225],{"className":228,"dataDisplayText":225,"href":229,"rel":230,"target":91,"title":225},[87],"/gis#set-sampling-method",[90],". If the\nrequested location is an area (i.e., an envelope or patch), the\nsample is computed by taking the average of all raster cells\ncovered by the requested area.",{"title":233,"searchDepth":234,"depth":235,"links":236},"",5,3,[237],{"id":19,"depth":235,"text":238,"children":239},"\n    gis:raster-sample\n  ",[240],{"id":29,"depth":241,"text":242},4,"\n    gis:raster-sample raster-dataset sample-location\n  ","Documentation for the raster-sample primitive.","md",{"source":246,"metadataOutputPath":247,"projectConfig":248,"language":256,"inheritFrom":264,"output":263,"version":249,"layout":265,"dictionaryDisplayName":266,"dictionaryHomeDirectory":267,"indexFileURI":268,"currentItemId":14,"currentItemLabel":25,"primRoot":83,"netlogoUrl":269,"icon":270,"extensionName":271,"assetsRoot":251},"../../external/extensions/gis/gis/raster-sample.md","content/gis/raster-sample.metadata.yaml",{"version":249,"projectRoot":250,"scanRoot":251,"outputRoot":252,"defaults":253,"engine":259,"partials":260,"dedupeIdenticalDiskWrites":263},"7.0.3",".","/Users/pas6148/Documents/netlogo/Helio/external/extensions/gis","content",{"inheritFrom":254,"language":256,"output":257,"extension":244,"title":258,"version":249},[255],0,"en",false,"NetLogo User Manual","mustac