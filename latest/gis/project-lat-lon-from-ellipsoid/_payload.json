[{"data":1,"prerenderedAt":209},["ShallowReactive",2],{"/gis/project-lat-lon-from-ellipsoid":3,"/gis/project-lat-lon-from-ellipsoid-surround":198},{"id":4,"title":5,"body":6,"description":164,"extension":165,"meta":166,"navigation":184,"path":194,"seo":195,"stem":196,"__hash__":197},"content/gis/project-lat-lon-from-ellipsoid.md","GIS Extension Dictionary: project-lat-lon-from-ellipsoid",{"type":7,"value":8,"toc":153},"minimark",[9],[10,11,15,16,15,26,57,61,95,106,109,145],"div",{"className":12,"id":14},[13],"dict_entry","project-lat-lon-from-ellipsoid","\n  ",[17,18,20,21,15],"h3",{"id":19},"gisproject-lat-lon-from-ellipsoid","\n    ",[22,23,25],"a",{"href":24},"#project-lat-lon-from-ellipsoid","gis:project-lat-lon-from-ellipsoid",[27,28,32],"h4",{"id":29,"className":30},"gisproject-lat-lon-from-ellipsoid-latitude-longitude-ellipsoid-radius-ellipsoid-inverse-flattening",[31],"section-heading",[22,33,20,37,15],{"className":34,"href":36},[35],"section-anchor","#----gisproject-lat-lon-from-ellipsoid-latitude-longitude-ellipsoid-radius-ellipsoid-inverse-flattening--",[38,39,42,43,47,48,47,51,47,54],"span",{"className":40},[41],"prim_example","gis:project-lat-lon-from-ellipsoid ",[44,45,46],"i",{},"latitude"," ",[44,49,50],{},"longitude",[44,52,53],{},"ellipsoid-radius",[44,55,56],{},"ellipsoid-inverse-flattening",[58,59,60],"p",{},"Report the position, in NetLogo space, of the given latitude\nand longitude pair according to the current map projection and\ntransformation and the given ellipsoid parameters.",[58,62,63,64,79,80,94],{},"Like the ",[65,66,71],"code",{"className":67,"displayText":69,"permalink":70},[68],"netlogo-command","gis:location-of","gis",[22,72,69],{"href":73,"rel":74,"className":76,"dataDisplayText":69,"target":78,"title":69},"/gis#location-of",[75],"noopener",[77],"netlogo-wiki-link","_self"," primitive, the reported xcor and ycor\nvalues are reported in a two-item list of ",[65,81,82,83,47,89,93],{},"[",[38,84,88],{"className":85},[86,87],"token","reporter","xcor",[38,90,92],{"className":91},[86,87],"ycor","]","\nand an empty list if the specified point is outside of\nthe bounds of the netlogo world.",[58,96,97,98,101,102,105],{},"The two defining parameters of a  ellipsoid for\nthe purposes of this primitive are the radius and the\ninverse flattening metric. These parameters can be\neasily found by examining either the WKT definition\nof a given projection/datum pair or the .prj file for\nthe desired datum. For example, if you open the .prj file\nfor a shapefile exported with the WGS66 datum in a text editor,\nyou will see, somewhere in the file, this bit of text:\n",[65,99,100],{},"DATUM[\"D_WGS_1966\",SPHEROID[\"NWL_9D\",6378145,298.25]]",".\nIf you look at the ",[65,103,104],{},"SPHEROID"," section of that text, the\nfirst number is the radius of that ellipoid and the\nsecond is the inverse flattening.",[58,107,108],{},"Once we have these numbers, we can project data that is\nrelative to WGS66 like so:",[110,111,112],"pre",{},[65,113,114,47,119,47,124,47,128,47,132,47,136,47,141],{},[38,115,118],{"className":116},[86,117],"command","let",[38,120,123],{"className":121},[86,122],"variable","location",[38,125,127],{"className":126},[86,122],"gis:project-lat-lon",[38,129,131],{"className":130},[86,122],"my-lat",[38,133,135],{"className":134},[86,122],"my-lon",[38,137,140],{"className":138},[86,139],"number","6378145",[38,142,144],{"className":143},[86,139],"298.25",[58,146,147,148],{},"For more on earth ellipoids, see: ",[22,149,150],{"href":150,"rel":151},"https://en.wikipedia.org/wiki/Earth_ellipsoid",[152],"nofollow",{"title":154,"searchDepth":155,"depth":156,"links":157},"",5,3,[158],{"id":19,"depth":156,"text":159,"children":160},"\n    gis:project-lat-lon-from-ellipsoid\n  ",[161],{"id":29,"depth":162,"text":163},4,"\n    gis:project-lat-lon-from-ellipsoid latitude longitude ellipsoid-radius ellipsoid-inverse-flattening\n  ","Documentation for the project-lat-lon-from-ellipsoid primitive.","md",{"source