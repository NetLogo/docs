portion"," are the parameters\nof the trend-line",[52,103,104,105,107,108,110,113],{},"\nY = \n",[94,106,96],{},"\n * \n",[94,109,100],{},[58,111,112],{},"\nt\n","\n.\n",[48,115,116,117,119,120,123,124,131,132,134,135,142,143,145,146,148],{},"Note that the growth proportion is typically interpreted as\n",[94,118,100],{}," = ",[94,121,122],{},"(1.0 + growth-rate)",". Therefore,\nif ",[65,125,127],{"className":126,"displayText":25,"permalink":82},[68],[22,128,25],{"className":129,"dataDisplayText":25,"href":82,"rel":130,"target":77,"title":25},[74],[76],"\nreturns a ",[94,133,100],{}," of 1.10, that implies that Y\ngrows by (1.10 - 1.0) = 10% each period. Note that if growth is\nnegative, ",[65,136,138],{"className":137,"displayText":25,"permalink":82},[68],[22,139,25],{"className":140,"dataDisplayText":25,"href":82,"rel":141,"target":77,"title":25},[74],[76],"\nwill return a ",[94,144,100],{}," of less than one. E.g., a\n",[94,147,100],{}," of 0.90 implies a growth rate of -10%.",[48,150,151,154,155,164,165,172,173,175],{},[89,152,153],{},"NOTE:"," The compound growth forecast is achieved by taking the\nln of Y. (See ",[65,156,160],{"className":157,"displayText":158,"permalink":159},[68],"matrix:regress","/matrix/regress",[22,161,158],{"className":162,"dataDisplayText":158,"href":159,"rel":163,"target":77,"title":158},[74],[76],", below.)\nBecause it is impossible to take the natural log of zero or a\nnegative number, ",[65,166,168],{"className":167,"displayText":25,"permalink":82},[68],[22,169,25],{"className":170,"dataDisplayText":25,"href":82,"rel":171,"target":77,"title":25},[74],[76],"\nwill result in an error if it finds a zero or negative number in\n",[94,174,46],{},".",[177,178,179],"pre",{},[65,180,181,187,190,195,196,200,201,195,206,195,210,195,214,195,218,195,222,226,227,229,200,233,195,237,195,241,195,245,226,249,251,255,257,261,263,267,269,273,275],{},[38,182,186],{"className":183},[184,185],"token","comment",";; a compound growth extrapolation of the next item in the list.",[188,189],"br",{},[38,191,194],{"className":192},[184,193],"command","print"," ",[38,197,25],{"className":198},[184,199],"variable"," [",[38,202,205],{"className":203},[184,204],"number","20",[38,207,209],{"className":208},[184,204],"25",[38,211,213],{"className":212},[184,204],"28",[38,215,217],{"className":216},[184,204],"32",[38,219,221],{"className":220},[184,204],"35",[38,223,225],{"className":224},[184,204],"39","]",[188,228],{},[38,230,232],{"className":231},[184,199],"=>",[38,234,236],{"className":235},[184,204],"45.60964465307147",[38,238,240],{"className":239},[184,204],"21.15254147944863",[38,242,244],{"className":243},[184,204],"1.136621034423892",[38,246,248],{"className":247},[184,204],"0.9760867518334806",[188,250],{},[38,252,254],{"className":253},[184,185],";; These results tell us:",[188,256],{},[38,258,260],{"className":259},[184,185],";; * the next predicted value is approximately 45.610",[188,262],{},[38,264,266],{"className":265},[184,185],";; * the compound growth trend line is given by Y = 21.1525 * 1.1366 ^ t",[188,268],{},[38,270,272],{"className":271},[184,185],";; * Y grows by approximately 13.66% each period",[188,274],{},[38,276,278],{"className":277},[184,185],";; * the R^2 value is roughly 0.9761 (a good fit)",{"title":280,"searchDepth":281,"depth":282,"links":283},"",5,3,[284],{"id":19,"depth":282,"text":285,"children":286},"\n    matrix:forecast-compound-growth\n  ",[287],{"id":29,"depth":288,"text":289},4,"\n    matrix:forecast-compound-growth data-list\n  ","Documentation for the forecast-compound-growth primitive.","md",{"source":293,"metadataOutputPath":294,"projectConfig":295,"language":302,"inheritFrom":310,"output":309,"version":296,"layout":311,"dictionaryDisplayName":312,"dictionaryHomeDirectory":313,"indexFileURI":314,"currentItemId":14,"currentItemLabel":25,"primRoot":315,"icon":316,"extensionName":317,"assetsRoot":297},"../../external/extensions/matrix/matrix/forecast-compound-growth.md","content/ma