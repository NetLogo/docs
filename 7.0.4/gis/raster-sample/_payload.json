[{"data":1,"prerenderedAt":285},["ShallowReactive",2],{"/gis/raster-sample":3,"/gis/raster-sample-surround":274},{"id":4,"title":5,"body":6,"description":240,"extension":241,"meta":242,"navigation":260,"path":270,"seo":271,"stem":272,"__hash__":273},"content/gis/raster-sample.md","GIS Extension Dictionary: raster-sample",{"type":7,"value":8,"toc":229},"minimark",[9],[10,11,15,16,15,26,51,55,113,116,217],"div",{"className":12,"id":14},[13],"dict_entry","raster-sample","\n  ",[17,18,20,21,15],"h3",{"id":19},"gisraster-sample","\n    ",[22,23,25],"a",{"href":24},"#raster-sample","gis:raster-sample",[27,28,32],"h4",{"id":29,"className":30},"gisraster-sample-raster-dataset-sample-location",[31],"section-heading",[22,33,20,37,15],{"className":34,"href":36},[35],"section-anchor","#----gisraster-sample-raster-dataset-sample-location--",[38,39,42,43,47,48],"span",{"className":40},[41],"prim_example","gis:raster-sample ",[44,45,46],"i",{},"raster-dataset"," ",[44,49,50],{},"sample-location",[52,53,54],"p",{},"Reports the value of the given raster over the given location. The\nlocation may be any of the following:",[56,57,58,92,104,107,110],"ul",{},[59,60,61,62,77,78,91],"li",{},"A list of length 2, which is taken to represent a point in\nnetlogo space (",[63,64,65,66,47,72,76],"code",{},"[",[38,67,71],{"className":68},[69,70],"token","reporter","xcor",[38,73,75],{"className":74},[69,70],"ycor","]",") of the sort reported by\n",[79,80,83],"primitive",{"displayText":81,"permalink":82},"gis:location-of","gis",[22,84,81],{"className":85,"dataDisplayText":81,"href":87,"rel":88,"target":90,"title":81},[86],"netlogo-wiki-link","/gis#location-of",[89],"noopener","_self"," Vertex. The raster\ndataset is sampled at the point of that location.",[59,93,94,95,103],{},"A list of length 4, which is taken to represent an envelope in\nGIS space, of the sort reported by ",[79,96,98],{"displayText":97,"permalink":82},"envelope-of",[22,99,97],{"className":100,"dataDisplayText":97,"href":101,"rel":102,"target":90,"title":97},[86],"/gis#envelope-of",[89],". The raster dataset is sampled\nover the area of that envelope.",[59,105,106],{},"A patch, in which case the raster dataset is sampled over the\narea of the patch.",[59,108,109],{},"A turtle, in which case the raster dataset is sampled at the\nlocation of that turtle.",[59,111,112],{},"A Vertex, in which case the raster dataset is sampled at the\nlocation of that Vertex.",[52,114,115],{},"If the requested location is outside the area covered by the raster\ndataset, this primitive reports the special value representing\n“not a number”, which is printed by NetLogo as\n“NaN”. Using the special “not a number” value\nas an argument to primitives that expect a number may cause an\nerror, but you can test the value reported by this primitive to\nfilter out “not a number” values. A value that is not a\nnumber will be neither less than nor greater than a number value,\nso you can detect “not a number” values using the\nfollowing:",[117,118,119],"pre",{},[63,120,121,47,126,47,131,47,134,47,138,47,142,147,150,155,157,161,162,47,165,47,169,172,173,161,177,47,180,47,184,187,188,190,191,47,195,47,199,204,205,190,207,47,210,47,213,204],{},[38,122,125],{"className":123},[69,124],"command","let",[38,127,130],{"className":128},[69,129],"variable","value",[38,132,25],{"className":133},[69,129],[38,135,137],{"className":136},[69,129],"dataset",[38,139,141],{"className":140},[69,70],"turtle",[38,143,146],{"className":144},[69,145],"number","0",[148,149],"br",{},[38,151,154],{"className":152},[69,153],"comment","; set color to blue if value is a number, red if value is \"not a number\"",[148,156],{},[38,158,160],{"className":159},[69,124],"ifelse"," (",[38,163,130],{"className":164},[69,129],[38,166,168],{"className":167},[69,70],"\u003C=",[38,170,146],{"className":171},[69,145],") ",[38,174,176],{"className":175},[69,70],"or",[38,178,130],{"className":179},[69,129],[38,181,183],{"className":182},[69,70],">=",[38,185,146],{"className":186},[69,145],")",[148,189],{},"[ ",[38,192,194],{"className":193},[69,124],"set",[38,196,198],{"className":197},[69,70],"color",[38,200,203],{"className":201},[69,202],"constant","blue"," ]",[148,206],{},[38,208,194],{"className":209},[69,124],[38,211,198],{"className":212},[69,70],[38,214,216],{"className":215},[69,202],"red",[52,218,219,220,228],{},"If the requested location is a point, the sample is always computed\nusing the method set by ",[79,221,223],{"displayText":222,"permalink":82},"gis:set-sampling-method",[22,224,222],{"className":225,"dataDisplayText":222,"href":226,"rel":227,"target":90,"title":222},[86],"/gis#set-sampling-method",[89],". If the\nrequested location is an area (i.e., an envelope or patch), the\nsample is computed by taking the average of all raster cells\ncovered by the requested area.",{"title":230,"searchDepth":231,"depth":232,"links":233},"",5,3,[234],{"id":19,"depth":232,"text":235,"children":236},"\n    gis:raster-sample\n  ",[237],{"id":29,"depth":238,"text":239},4,"\n    gis:raster-sample raster-dataset sample-location\n  ","Documentation for the raster-sample primitive.","md",{"source":243,"metadataOutputPath":244,"projectConfig":245,"language":253,"inheritFrom":261,"output":260,"version":246,"layout":262,"dictionaryDisplayName":263,"dictionaryHomeDirectory":264,"indexFileURI":265,"currentItemId":14,"currentItemLabel":25,"primRoot":82,"netlogoUrl":266,"icon":267,"extensionName":268,"assetsRoot":248},"../../external/extensions/gis/gis/raster-sample.md","content/gis/raster-sample.metadata.yaml",{"version":246,"projectRoot":247,"scanRoot":248,"outputRoot":249,"defaults":250,"engine":256,"partials":257,"dedupeIdenticalDiskWrites":260},"7.0.4",".","/home/runner/work/Helio/Helio/external/extensions/gis","content",{"inheritFrom":251,"language":253,"output":254,"extension":241,"title":255,"version":246},[252],0,"en",false,"NetLogo User Manual","mustache",{"directoryPaths":258,"extensions":259},[247],[256,241],true,[252],"catalog","GIS Extension Dictionary","/gis.html","/_index/extensions/gis.txt","http://ccl.northwestern.edu/netlogo/docs/","i-lucide-map-pin",{"shortName":82,"fullName":269},"GIS","/gis/raster-sample",{"title":5,"description":240},"gis/raster-sample","mCey0UaEHVgzwBgK4DJ8WZLD1mf0qKtIgAq_UxbRbEk",[275,280],{"title":276,"path":277,"stem":278,"description":279},"GIS Extension Dictionary: random-point-inside","/gis/random-point-inside","gis/random-point-inside","Documentation for the random-point-inside primitive.",{"title":281,"path":282,"stem":283,"description":284},"GIS Extension Dictionary: raster-value","/gis/raster-value","gis/raster-value","Documentation for the raster-value primitive.",1778864976413]