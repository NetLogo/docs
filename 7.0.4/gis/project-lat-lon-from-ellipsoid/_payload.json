[{"data":1,"prerenderedAt":208},["ShallowReactive",2],{"/gis/project-lat-lon-from-ellipsoid":3,"/gis/project-lat-lon-from-ellipsoid-surround":197},{"id":4,"title":5,"body":6,"description":163,"extension":164,"meta":165,"navigation":183,"path":193,"seo":194,"stem":195,"__hash__":196},"content/gis/project-lat-lon-from-ellipsoid.md","GIS Extension Dictionary: project-lat-lon-from-ellipsoid",{"type":7,"value":8,"toc":152},"minimark",[9],[10,11,15,16,15,26,57,61,94,105,108,144],"div",{"className":12,"id":14},[13],"dict_entry","project-lat-lon-from-ellipsoid","\n  ",[17,18,20,21,15],"h3",{"id":19},"gisproject-lat-lon-from-ellipsoid","\n    ",[22,23,25],"a",{"href":24},"#project-lat-lon-from-ellipsoid","gis:project-lat-lon-from-ellipsoid",[27,28,32],"h4",{"id":29,"className":30},"gisproject-lat-lon-from-ellipsoid-latitude-longitude-ellipsoid-radius-ellipsoid-inverse-flattening",[31],"section-heading",[22,33,20,37,15],{"className":34,"href":36},[35],"section-anchor","#----gisproject-lat-lon-from-ellipsoid-latitude-longitude-ellipsoid-radius-ellipsoid-inverse-flattening--",[38,39,42,43,47,48,47,51,47,54],"span",{"className":40},[41],"prim_example","gis:project-lat-lon-from-ellipsoid ",[44,45,46],"i",{},"latitude"," ",[44,49,50],{},"longitude",[44,52,53],{},"ellipsoid-radius",[44,55,56],{},"ellipsoid-inverse-flattening",[58,59,60],"p",{},"Report the position, in NetLogo space, of the given latitude\nand longitude pair according to the current map projection and\ntransformation and the given ellipsoid parameters.",[58,62,63,64,77,78,93],{},"Like the ",[65,66,69],"primitive",{"displayText":67,"permalink":68},"gis:location-of","gis",[22,70,67],{"href":71,"rel":72,"className":74,"dataDisplayText":67,"target":76,"title":67},"/gis#location-of",[73],"noopener",[75],"netlogo-wiki-link","_self"," primitive, the reported xcor and ycor\nvalues are reported in a two-item list of ",[79,80,81,82,47,88,92],"code",{},"[",[38,83,87],{"className":84},[85,86],"token","reporter","xcor",[38,89,91],{"className":90},[85,86],"ycor","]","\nand an empty list if the specified point is outside of\nthe bounds of the netlogo world.",[58,95,96,97,100,101,104],{},"The two defining parameters of a  ellipsoid for\nthe purposes of this primitive are the radius and the\ninverse flattening metric. These parameters can be\neasily found by examining either the WKT definition\nof a given projection/datum pair or the .prj file for\nthe desired datum. For example, if you open the .prj file\nfor a shapefile exported with the WGS66 datum in a text editor,\nyou will see, somewhere in the file, this bit of text:\n",[79,98,99],{},"DATUM[\"D_WGS_1966\",SPHEROID[\"NWL_9D\",6378145,298.25]]",".\nIf you look at the ",[79,102,103],{},"SPHEROID"," section of that text, the\nfirst number is the radius of that ellipoid and the\nsecond is the inverse flattening.",[58,106,107],{},"Once we have these numbers, we can project data that is\nrelative to WGS66 like so:",[109,110,111],"pre",{},[79,112,113,47,118,47,123,47,127,47,131,47,135,47,140],{},[38,114,117],{"className":115},[85,116],"command","let",[38,119,122],{"className":120},[85,121],"variable","location",[38,124,126],{"className":125},[85,121],"gis:project-lat-lon",[38,128,130],{"className":129},[85,121],"my-lat",[38,132,134],{"className":133},[85,121],"my-lon",[38,136,139],{"className":137},[85,138],"number","6378145",[38,141,143],{"className":142},[85,138],"298.25",[58,145,146,147],{},"For more on earth ellipoids, see: ",[22,148,149],{"href":149,"rel":150},"https://en.wikipedia.org/wiki/Earth_ellipsoid",[151],"nofollow",{"title":153,"searchDepth":154,"depth":155,"links":156},"",5,3,[157],{"id":19,"depth":155,"text":158,"children":159},"\n    gis:project-lat-lon-from-ellipsoid\n  ",[160],{"id":29,"depth":161,"text":162},4,"\n    gis:project-lat-lon-from-ellipsoid latitude longitude ellipsoid-radius ellipsoid-inverse-flattening\n  ","Documentation for the project-lat-lon-from-ellipsoid primitive.","md",{"source":166,"metadataOutputPath":