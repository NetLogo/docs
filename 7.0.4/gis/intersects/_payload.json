[{"data":1,"prerenderedAt":137},["ShallowReactive",2],{"/gis/intersects":3,"/gis/intersects-surround":126},{"id":4,"title":5,"body":6,"description":91,"extension":92,"meta":93,"navigation":111,"path":122,"seo":123,"stem":124,"__hash__":125},"content/gis/intersects.md","GIS Extension Dictionary: intersects",{"type":7,"value":8,"toc":80},"minimark",[9],[10,11,15,16,15,26,51,55],"div",{"className":12,"id":14},[13],"dict_entry","intersects","\n  ",[17,18,20,21,15],"h3",{"id":19},"gisintersects","\n    ",[22,23,25],"a",{"href":24},"#intersects","gis:intersects?",[27,28,32],"h4",{"id":29,"className":30},"gisintersects-x-y",[31],"section-heading",[22,33,20,37,15],{"className":34,"href":36},[35],"section-anchor","#----gisintersects-x-y--",[38,39,42,43,47,48],"span",{"className":40},[41],"prim_example","gis:intersects? ",[44,45,46],"i",{},"x"," ",[44,49,50],{},"y",[52,53,54],"p",{},"Reports true if the given objects’ spatial representations\nshare at least one point in common, and false otherwise. The\nobjects x and y may be any one of:",[56,57,58,62,65,68,71,74,77],"ul",{},[59,60,61],"li",{},"a VectorDataset, in which case the object’s spatial\nrepresentation is the union of all the points, lines, or polygons\nthe dataset contains.",[59,63,64],{},"a VectorFeature, in which case the object’s spatial\nrepresentation is defined by the point, line, or polygon the\nfeature contains.",[59,66,67],{},"A turtle, in which case the spatial representation is a point.",[59,69,70],{},"A link, whose spatial representation is a line segment\nconnecting the two points represented by the turtles the link is\nconnecting.",[59,72,73],{},"A patch, whose spatial representation is a rectangular polygon.",[59,75,76],{},"An agentset, whose spatial representation is the union of the\nrepresentations of all of the agents it contains.",[59,78,79],{},"A list containing of any of the items listed here, including\nanother list. The spatial representation of such a list is the\nunion of the spatial repres