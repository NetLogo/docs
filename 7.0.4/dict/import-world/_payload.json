[{"data":1,"prerenderedAt":180},["ShallowReactive",2],{"/dict/import-world":3,"/dict/import-world-surround":169},{"id":4,"title":5,"body":6,"description":136,"extension":137,"meta":138,"navigation":156,"path":165,"seo":166,"stem":167,"__hash__":168},"content/dict/import-world.md","NetLogo Dictionary: import-world",{"type":7,"value":8,"toc":125},"minimark",[9],[10,11,16,35,58,75,78,81,105,115],"div",{"className":12,"id":14,"role":15},[13],"dict_entry","import-world","region",[17,18,20],"h3",{"id":19},"import-world10",[21,22,26,27],"a",{"href":23,"role":24,"ariaLabel":25},"#import-world","doc-noteref","Reference to import-world","\nimport-world\n",[28,29,34],"span",{"className":30,"role":32,"ariaLabel":33},[31],"since","note","Since version","\n1.0\n",[36,37,41],"h4",{"id":38,"className":39},"import-world-filename",[40],"section-heading",[21,42,46],{"className":43,"href":45},[44],"section-anchor","#import-world-filename",[28,47,50],{"className":48},[49],"prim_example",[51,52,53,54],"p",{},"import-world ",[55,56,57],"em",{},"filename",[51,59,60,61,74],{},"Reads the values of all variables for a model, both built-in and\nuser-defined, including all observer, turtle, and patch variables,\nfrom an external file named by the given string. The file should be\nin the format used by the ",[62,63,66],"primitive",{"displayText":64,"permalink":65},"export-world","export-cmds",[21,67,64],{"href":68,"rel":69,"className":71,"dataDisplayText":64,"target":73,"title":64},"/dictionary#export-cmds",[70],"noopener",[72],"netlogo-wiki-link","_self","primitive.",[51,76,77],{},"Note that the functionality of this primitive is also directly\navailable from NetLogo’s File menu.",[51,79,80],{},"When using import-world, to avoid errors, perform these steps in\nthe following order:",[82,83,84,88,91,94,102],"ol",{},[85,86,87],"li",{},"Open the model from which you created the export file.",[85,89,90],{},"Press the Setup button, to get the model in a state from which\nit can be run.",[85,92,93],{},"Import the file.",[85,95,96,97,101],{},"Re-open any files that the model had opened with the ",[98,99,100],"code",{},"file-open"," command.",[85,103,104],{},"If you want, press Go button to continue running the model from\nthe point where it left off.",[51,106,107,108,114],{},"If you wish to import a file from a location other than the\nmodel’s location, you may include the full path to the file you\nwish to import. See ",[62,109,110],{"displayText":64,"permalink":65},[21,111,64],{"href":68,"rel":112,"className":113,"dataDisplayText":64,"target":73,"title":64},[70],[72]," for an\nexample.",[51,116,117,118,124],{},"Note: This primitive is not compatible with NetLogo Web. If you\nwish to import a world with the same code and the\nsame behavior in both NetLogo and NetLogo Web, see ",[21,119,123],{"href":120,"rel":121},"https://github.com/NetLogo/ImportA-Extension#readme",[122],"nofollow","import-a:world",".",{"title":126,"searchDepth":127,"depth":128,"links":129},"",5,3,[130],{"id":19,"depth":128,"text":131,"children":132},"\nimport-world\n\n1.0\n",[133],{"id":38,"depth":134,"text":135},4,"import-world filename","Documentation for the import-world primitive.","md",{"source":139,"metadataOutputPath":140,"projectConfig":141,"language":148,"inheritFrom":157,"output":156,"version":142,"layout":158,"dictionaryDisplayName":159,"dictionaryHomeDirectory":160,"indexFileURI":161,"currentItemId":14,"currentItemLabel":14,"primRoot":162,"icon":163,"assetsRoot":164},"autogen/dict/import-world.md","content/dict/import-world.metadata.yaml",{"version":142,"projectRoot":124,"scanRoot":143,"outputRoot":144,"defaults":145,"engine":151,"partials":152,"dedupeIdenticalDiskWrites":156},"7.0.4","autogen","content",{"inheritFrom":146,"language":148,"output":149,"extension":137,"title":150,"version":142},[147],0,"en",false,"NetLogo User Manual","handlebars",{"directoryPaths":153,"extensions":154},[124],[155,137],"mustache",true,[147],"catalog","NetLogo Dictionary","/dictionary.html","/_index/d