[{"data":1,"prerenderedAt":253},["ShallowReactive",2],{"/dict/patch":3,"/dict/patch-surround":242},{"id":4,"title":5,"body":6,"description":209,"extension":210,"meta":211,"navigation":229,"path":238,"seo":239,"stem":240,"__hash__":241},"content/dict/patch.md","NetLogo Dictionary: patch",{"type":7,"value":8,"toc":198},"minimark",[9],[10,11,16,35,62,65,68,71,182],"div",{"className":12,"id":14,"role":15},[13],"dict_entry","patch","region",[17,18,20],"h3",{"id":19},"patch10",[21,22,26,27],"a",{"href":23,"role":24,"ariaLabel":25},"#patch","doc-noteref","Reference to patch","\npatch\n",[28,29,34],"span",{"className":30,"role":32,"ariaLabel":33},[31],"since","note","Since version","\n1.0\n",[36,37,41],"h4",{"id":38,"className":39},"patch-xcor-ycor",[40],"section-heading",[21,42,46],{"className":43,"href":45},[44],"section-anchor","#patch-xcor-ycor",[28,47,50],{"className":48},[49],"prim_example",[51,52,53,54,58,59],"p",{},"patch ",[55,56,57],"em",{},"xcor"," ",[55,60,61],{},"ycor",[51,63,64],{},"Given the x and y coordinates of a point, reports the patch\ncontaining that point. (The coordinates are absolute coordinates;\nthey are not computed relative to this agent, as with patch-at.)",[51,66,67],{},"If x and y are integers, the point is the center of a patch. If x\nor y is not an integer, rounding to the nearest integer is used to\ndetermine which patch contains the point.",[51,69,70],{},"If wrapping is allowed by the topology, the given coordinates will\nbe wrapped to be within the world. If wrapping is not allowed and\nthe given coordinates are outside the world, reports nobody.",[72,73,74],"pre",{},[75,76,77,58,83,58,87,58,92,96,97,58,101,58,105,110,111,114,119,121,58,125,58,128,58,132,136,138,142,144,58,147,58,150,58,154,158,160,164,166,170,172,176,178],"code",{},[28,78,82],{"className":79},[80,81],"token","command","ask",[28,84,14],{"className":85},[80,86],"reporter",[28,88,91],{"className":89},[80,90],"number","3",[28,93,95],{"className":94},[80,90],"-4"," [ ",[28,98,100],{"className":99},[80,81],"set",[28,102,104],{"className":103},[80,86],"pcolor",[28,106,109],{"className":107},[80,108],"constant","green"," ]",[112,113],"br",{},[28,115,118],{"className":116},[80,117],"comment",";; patch with pxcor of 3 and pycor of -4 turns green",[112,120],{},[28,122,124],{"className":123},[80,81],"show",[28,126,14],{"className":127},[80,86],[28,129,131],{"className":130},[80,90],"1.2",[28,133,135],{"className":134},[80,90],"3.7",[112,137],{},[28,139,141],{"className":140},[80,117],";; prints (patch 1 4); note rounding",[112,143],{},[28,145,124],{"className":146},[80,81],[28,148,14],{"className":149},[80,86],[28,151,153],{"className":152},[80,90],"18",[28,155,157],{"className":156},[80,90],"19",[112,159],{},[28,161,163],{"className":162},[80,117],";; supposing min-pxcor and min-pycor are -17",[112,165],{},[28,167,169],{"className":168},[80,117],";; and max-pxcor and max-pycor are 17,",[112,171],{},[28,173,175],{"className":174},[80,117],";; in a wrapping topology, prints (patch -17 -16);",[112,177],{},[28,179,181],{"className":180},[80,117],";; in a non-wrapping topology, prints nobody",[51,183,184,185,197],{},"See also ",[186,187,189],"primitive",{"displayText":188,"permalink":188},"patch-at",[21,190,188],{"className":191,"dataDisplayText":188,"href":193,"rel":194,"target":196,"title":188},[192],"netlogo-wiki-link","/dictionary#patch-at",[195],"noopener","_self",".",{"title":199,"searchDepth":200,"depth":201,"links":202},"",5,3,[203],{"id":19,"depth":201,"text":204,"children":205},"\npatch\n\n1.0\n",[206],{"id":38,"depth":207,"text":208},4,"patch xcor ycor","Documentation for the patch primitive.","md",{"source":212,"metadataOutputPath":213,"projectConfig":214,"language":221,"inheritFrom":230,"output":229,"version":215,"layout":231,"dictionaryDisplayName":232,"dictionaryHomeDirectory":233,"indexFileURI":234,"currentItemId":14,"currentItemLabel":14,"primRoot":235,"icon":236,"assetsRoot":237},"autogen/dict/patch.md","content/dict/patch.metad