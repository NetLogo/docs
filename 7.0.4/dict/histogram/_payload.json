[{"data":1,"prerenderedAt":233},["ShallowReactive",2],{"/dict/histogram":3,"/dict/histogram-surround":222},{"id":4,"title":5,"body":6,"description":189,"extension":190,"meta":191,"navigation":209,"path":218,"seo":219,"stem":220,"__hash__":221},"content/dict/histogram.md","NetLogo Dictionary: histogram",{"type":7,"value":8,"toc":178},"minimark",[9],[10,11,16,35,58,61,64,67,70,105,108,111,152,155],"div",{"className":12,"id":14,"role":15},[13],"dict_entry","histogram","region",[17,18,20],"h3",{"id":19},"histogram10",[21,22,26,27],"a",{"href":23,"role":24,"ariaLabel":25},"#histogram","doc-noteref","Reference to histogram","\nhistogram\n",[28,29,34],"span",{"className":30,"role":32,"ariaLabel":33},[31],"since","note","Since version","\n1.0\n",[36,37,41],"h4",{"id":38,"className":39},"histogram-list",[40],"section-heading",[21,42,46],{"className":43,"href":45},[44],"section-anchor","#histogram-list",[28,47,50],{"className":48},[49],"prim_example",[51,52,53,54],"p",{},"histogram ",[55,56,57],"em",{},"list",[51,59,60],{},"Histograms the values in the given list",[51,62,63],{},"Draws a histogram showing the frequency distribution of the values\nin the list. The heights of the bars in the histogram represent the\nnumbers of values in each subrange.",[51,65,66],{},"Before the histogram is drawn, first any previous points drawn by\nthe current plot pen are removed.",[51,68,69],{},"Any non-numeric values in the list are ignored.",[51,71,72,73,86,87,95,96,104],{},"The histogram is drawn on the current plot using the current plot\npen and pen color. Auto scaling does not affect a histogram’s\nhorizontal range, so ",[74,75,78],"primitive",{"displayText":76,"permalink":77},"set-plot-x-range","set-plot-range",[21,79,76],{"className":80,"dataDisplayText":76,"href":82,"rel":83,"target":85,"title":76},[81],"netlogo-wiki-link","/dictionary#set-plot-range",[84],"noopener","_self"," should be used to control the\nrange, and the pen interval can then be set (either directly with ",[74,88,90],{"displayText":89,"permalink":89},"set-plot-pen-interval",[21,91,89],{"className":92,"dataDisplayText":89,"href":93,"rel":94,"target":85,"title":89},[81],"/dictionary#set-plot-pen-interval",[84],", or indirectly via ",[74,97,99],{"displayText":98,"permalink":98},"set-histogram-num-bars",[21,100,98],{"className":101,"dataDisplayText":98,"href":102,"rel":103,"target":85,"title":98},[81],"/dictionary#set-histogram-num-bars",[84],") to\ncontrol how many bars that range is split up into.",[51,106,107],{},"Be sure that if you want the histogram drawn with bars that the\ncurrent pen is in bar mode (mode 1).",[51,109,110],{},"For histogramming purposes the plot’s X range is not considered\nto include the maximum X value. Values equal to the maximum X will\nfall outside of the histogram’s range.",[112,113,114],"pre",{},[115,116,117,122,123,128,129,133,134,138,141,146,148],"code",{},[28,118,14],{"className":119},[120,121],"token","command"," [",[28,124,127],{"className":125},[120,126],"reporter","color","] ",[28,130,132],{"className":131},[120,126],"of"," ",[28,135,137],{"className":136},[120,126],"turtles",[139,140],"br",{},[28,142,145],{"className":143},[120,144],"comment",";; draws a histogram showing how many turtles there are",[139,147],{},[28,149,151],{"className":150},[120,144],";; of each color",[51,153,154],{},"This command will produce a runtime error if either the current plot or the current\npen has not been set.",[51,156,157,158,164,165,164,171,177],{},"See also ",[74,159,160],{"displayText":98,"permalink":98},[21,161,98],{"className":162,"dataDisplayText":98,"href":102,"rel":163,"target":85,"title":98},[81],[84],", ",[74,166,167],{"displayText":89,"permalink":89},[21,168,89],{"className":169,"dataDisplayText":89,"href":93,"rel":170,"target":85,"title":89},[81],[84],[74,172,173],{"displayText":76,"permalink":77},[21,174,76],{"className":175,"dataDisplayText":76,"href":82,"rel":176,"target":85,"title":76},[81],[84],".",{"title":179,"searchDepth":180,"depth":181,