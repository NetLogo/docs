[{"data":1,"prerenderedAt":122},["ShallowReactive",2],{"/nw/closeness-centrality":3,"/nw/closeness-centrality-surround":111},{"id":4,"title":5,"body":6,"description":77,"extension":78,"meta":79,"navigation":97,"path":107,"seo":108,"stem":109,"__hash__":110},"content/nw/closeness-centrality.md","Networks Extension Dictionary: closeness-centrality",{"type":7,"value":8,"toc":67},"minimark",[9],[10,11,15,16,15,26,42,53],"div",{"className":12,"id":14},[13],"dict_entry","closeness-centrality","\n  ",[17,18,20,21,15],"h3",{"id":19},"nwcloseness-centrality","\n    ",[22,23,25],"a",{"href":24},"#closeness-centrality","nw:closeness-centrality",[27,28,32],"h4",{"id":29,"className":30},"nwcloseness-centrality-1",[31],"section-heading",[22,33,20,37,15],{"className":34,"href":36},[35],"section-anchor","#----nwcloseness-centrality---1",[38,39,25],"span",{"className":40},[41],"prim_example",[43,44,45,46,52],"p",{},"The ",[22,47,51],{"href":48,"rel":49},"https://en.wikipedia.org/wiki/Centrality#Closeness_centrality",[50],"nofollow","closeness centrality"," of a turtle is defined as the inverse of the average of it’s distances to all other turtles. (Some people use the sum of distances instead of the average, but the extension uses the average.)",[43,54,55,56,60,61,66],{},"Note that this primitive reports the ",[57,58,59],"em",{},"intra-component"," closeness of a turtle, that is, it takes into account only the distances to the turtles that are part of the same ",[22,62,65],{"href":63,"rel":64},"https://en.wikipedia.org/wiki/Connected_component_%28graph_theory%29",[50],"component"," as the current turtle, since distance to turtles in other components is undefined. The closeness centrality of an isolated turtle is defined to be zero.",{"title":68,"searchDepth":69,"depth":70,"links":71},"",5,3,[72],{"id":19,"depth":70,"text":73,"children":74},"\n    nw:closeness-centrality\n  ",[75],{"id":29,"depth":76,"text":73},4,"Documentation for the closeness-centrality primitive.","md",{"source":