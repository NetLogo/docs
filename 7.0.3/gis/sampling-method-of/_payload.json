[{"data":1,"prerenderedAt":200},["ShallowReactive",2],{"/gis/sampling-method-of":3,"/gis/sampling-method-of-surround":189},{"id":4,"title":5,"body":6,"description":156,"extension":157,"meta":158,"navigation":175,"path":185,"seo":186,"stem":187,"__hash__":188},"content/gis/sampling-method-of.md","GIS Extension Dictionary: sampling-method-of",{"type":7,"value":8,"toc":145},"minimark",[9],[10,11,15,16,15,26,47,96,136],"div",{"className":12,"id":14},[13],"dict_entry","sampling-method-of","\n  ",[17,18,20,21,15],"h3",{"id":19},"gissampling-method-of","\n    ",[22,23,25],"a",{"href":24},"#sampling-method-of","gis:sampling-method-of",[27,28,32],"h4",{"id":29,"className":30},"gissampling-method-of-raster-dataset",[31],"section-heading",[22,33,20,37,15],{"className":34,"href":36},[35],"section-anchor","#----gissampling-method-of-raster-dataset--",[38,39,42,43],"span",{"className":40},[41],"prim_example","gis:sampling-method-of ",[44,45,46],"i",{},"raster-dataset",[48,49,50,51,66,67,66,76,85,86,95],"p",{},"Reports the sampling method used to compute the value of the given\nraster dataset at a single point, or over an area smaller than a\nsingle raster cell. Sampling is performed by the GIS extension\nprimitives ",[52,53,58],"code",{"className":54,"displayText":56,"permalink":57},[55],"netlogo-command","gis:raster-sample","gis",[22,59,56],{"className":60,"dataDisplayText":56,"href":62,"rel":63,"target":65,"title":56},[61],"netlogo-wiki-link","/gis#raster-sample",[64],"noopener","_self",", ",[52,68,71],{"className":69,"displayText":70,"permalink":57},[55],"gis:resample",[22,72,70],{"className":73,"dataDisplayText":70,"href":74,"rel":75,"target":65,"title":70},[61],"/gis#resample",[64],[52,77,80],{"className":78,"displayText":79,"permalink":57},[55],"gis:convolve",[22,81,79],{"className":82,"dataDisplayText":79,"href":83,"rel":84,"target":65,"title":79},[61],"/gis#convolve",[64],",\nand ",[52,87,90],{"className":88,"displayText":89,"permalink":57},[55],"gis:apply-raster",[22,91,89],{"className":92,"dataDisplayText":89,"href":93,"rel":94,"target":65,"title":89},[61],"/gis#apply-raster",[64],". The sampling\nmethod will be one of the following:",[97,98,99,106,112,123],"ul",{},[100,101,102,105],"li",{},[52,103,104],{},"\"NEAREST_NEIGHBOR\"",": the value of the cell\nnearest the sampling location is used.",[100,107,108,111],{},[52,109,110],{},"\"BILINEAR\"",": the value of the four nearest\ncells are sampled by linear weighting, according to their\nproximity to the sampling site.",[100,113,114,117,118,122],{},[52,115,116],{},"\"BICUBIC\"",": the value of the sixteen nearest\ncells are sampled, and their values are combined by weight\naccording to a piecewise cubic polynomial recommended by Rifman\n(see ",[119,120,121],"em",{},"Digital Image Warping",", George Wolberg, 1990, pp\n129-131, IEEE Computer Society Press).",[100,124,125,128,129,132,133,135],{},[52,126,127],{},"\"BICUBIC_2\"",": the value is sampled using the\nsame procedure and the same polynomial as with ",[52,130,131],{},"BICUBIC","\nabove, but using a different coefficient. This method may produce\nsomewhat sharper results than ",[52,134,131],{},", but that result\nis data dependent.",[48,137,138,139,144],{},"For more information on these sampling methods and on raster\nsampling in general, see ",[22,140,143],{"href":141,"target":142},"https://en.wikipedia.org/wiki/Image_scaling","_blank","this wikipedia\narticle",".",{"title":146,"searchDepth":147,"depth":148,"links":149},"",5,3,[150],{"id":19,"depth":148,"text":151,"children":152},"\n    gis:sampling-method-of\n  ",[153],{"id":29,"depth":154,"text":155},4,"\n    gis:sampling-method-of raster-dataset\n  ","Documentation for the sampling-method-of primitive.","md",{"source":159,"metadataOutputPath":160,"projectConfig":161,"language":168,"inheritFrom":176,"output":175,"version":162,"layout":177,"dictionaryDisplayName":178,"dictionaryHomeDirectory":179,"indexFileURI":180,"currentItemId":14,"currentItemLabel":25,"primRoot":57,"netlogoUrl":181,"icon":182,"extensionName":183,"assetsRoot":163},"../../external/extensions/gis/gis/sampling-method-of.md","content/gis/sampling-method-of.metadata.yaml",{"version":162,"projectRoot":144,"scanRoot":163,"outputRoot":164,"defaults":165,"engine":171,"partials":172,"dedupeIdenticalDiskWrites":175},"7.0.3","/Users/pas6148/Documents/netlogo/Helio/external/extensions/gis","content",{"inheritFrom":166,"language":168,"output":169,"extension":157,"title":170,"version":162},[167],0,"en",false,"NetLogo User Manual","mustache",{"directoryPaths":173,"extensions":174},[144],[171,157],true,[167],"catalog","GIS Extension Dictionary","/gis.html","/_index/extensions/gis.txt","http://ccl.northwestern.edu/netlogo/docs/","i-lucide-map-pin",{"shortName":57,"fullName":184},"GIS","/gis/sampling-method-of",{"title":5,"description":156},"gis/sampling-method-of","pRnntn2vA3Dx5DT-Vai57XoVlLvizQ4bX2V85idCc9s",[190,195],{"title":191,"path":192,"stem":193,"description":194},"GIS Extension Dictionary: resample","/gis/resample","gis/resample","Documentation for the resample primitive.",{"title":196,"path":197,"stem":198,"description":199},"GIS Extension Dictionary: set-coordinate-system","/gis/set-coordinate-system","gis/set-coordinate-system","Documentation for the set-coordinate-system primitive.",1768414992343]