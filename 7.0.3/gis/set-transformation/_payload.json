ions of the NetLogo world:",[63,95,96],{},[66,97,98,99,47,104,47,109,47,113,47,117,121,122,98,125,47,128,47,132,47,136,47,140,121],{},"(",[38,100,103],{"className":101},[72,102],"reporter","list",[38,105,108],{"className":106},[72,107],"number","-180",[38,110,112],{"className":111},[72,107],"180",[38,114,116],{"className":115},[72,107],"-90",[38,118,120],{"className":119},[72,107],"90",")",[123,124],"br",{},[38,126,103],{"className":127},[72,102],[38,129,131],{"className":130},[72,102],"min-pxcor",[38,133,135],{"className":134},[72,102],"max-pxcor",[38,137,139],{"className":138},[72,102],"min-pycor",[38,141,143],{"className":142},[72,102],"max-pycor",[52,145,146,147,161],{},"However, if you’re setting the envelope of the NetLogo world,\nyou should probably be using ",[66,148,153],{"className":149,"displayText":151,"permalink":152},[150],"netlogo-command","gis:set-world-envelope","gis",[22,154,151],{"className":155,"dataDisplayText":151,"href":157,"rel":158,"target":160,"title":151},[156],"netlogo-wiki-link","/gis#set-world-envelope",[159],"noopener","_self",".",{"title":163,"searchDepth":164,"depth":165,"links":166},"",5,3,[167],{"id":19,"depth":165,"text":168,"children":169},"\n    gis:set-transformation\n  ",[170],{"id":29,"depth":171,"text":172},4,"\n    gis:set-transformation gis-envelope netlogo-envelope\n  ","Documentation for the set-transformation primitive.","md",{"source":176,"metadataOutputPath":177,"projectConfig":178,"language":185,"inheritFrom":193,"output":192,"version":179,"layout":194,"dictionaryDisplayName":195,"dictionaryHomeDirectory":196,"indexFileURI":197,"currentItemId":14,"currentItemLabel":25,"primRoot":152,"netlogoUrl":198,"icon":199,"extensionName":200,"assetsRoot":180},"../../external/extensions/gis/gis/set-transformation.md","content/gis/set-transformation.metadata.yaml",{"version":179,"projectRoot":161,"scanRoot":180,"outputRoot":181,"defaults":182,"engine":188,"partials":189,"dedupeIdenticalDiskWrites":192},"7.0.3","/home/runner/work/H