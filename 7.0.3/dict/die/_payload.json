[{"data":1,"prerenderedAt":316},["ShallowReactive",2],{"/dict/die":3,"/dict/die-surround":305},{"id":4,"title":5,"body":6,"description":272,"extension":273,"meta":274,"navigation":292,"path":301,"seo":302,"stem":303,"__hash__":304},"content/dict/die.md","NetLogo Dictionary: die",{"type":7,"value":8,"toc":262},"minimark",[9],[10,11,16,35,65,68,146,149,237],"div",{"className":12,"id":14,"role":15},[13],"dict_entry","die","region",[17,18,20],"h3",{"id":19},"die10",[21,22,26,27],"a",{"href":23,"role":24,"ariaLabel":25},"#die","doc-noteref","Reference to die","\ndie\n",[28,29,34],"span",{"className":30,"role":32,"ariaLabel":33},[31],"since","note","Since version","\n1.0\n",[36,37,40],"h4",{"id":14,"className":38},[39],"section-heading",[21,41,44,51,59],{"className":42,"href":23},[43],"section-anchor",[28,45,48],{"className":46},[47],"prim_example",[49,50,14],"p",{},[52,53],"img",{"alt":54,"src":55,"width":56,"height":56,"style":57},"Turtle Command","/_content/images/turtle.png",16,{"aspectRatio":58},"56/56",[52,60],{"alt":61,"src":62,"width":56,"height":56,"style":63},"Link Command","/_content/images/link.png",{"aspectRatio":64},"88/88",[49,66,67],{},"The turtle or link dies.",[69,70,71],"pre",{},[72,73,74,80,81,80,86,80,90,95,96,99,100,103,108,110,80,114,80,118,122,123,80,127,80,131,136,137,99,140,142],"code",{},[28,75,79],{"className":76},[77,78],"token","command","if"," ",[28,82,85],{"className":83},[77,84],"reporter","xcor",[28,87,89],{"className":88},[77,84],">",[28,91,94],{"className":92},[77,93],"number","20"," [ ",[28,97,14],{"className":98},[77,78]," ]",[101,102],"br",{},[28,104,107],{"className":105},[77,106],"comment",";; all turtles with xcor greater than 20 die",[101,109],{},[28,111,113],{"className":112},[77,78],"ask",[28,115,117],{"className":116},[77,84],"links",[28,119,121],{"className":120},[77,84],"with"," [",[28,124,126],{"className":125},[77,84],"color",[28,128,130],{"className":129},[77,84],"=",[28,132,135],{"className":133},[77,134],"constant","blue","] [ ",[28,138,14],{"className":139},[77,78],[101,141],{},[28,143,145],{"className":144},[77,106],";; all the blue links will die",[49,147,148],{},"A dead agent ceases to exist. The effects of this include:",[150,151,152,178,181,227,230],"ul",{},[153,154,155,156,177],"li",{},"The agent will not execute any further code. So if you write ",[72,157,158,80,161,95,165,80,168,80,172,99],{},[28,159,113],{"className":160},[77,78],[28,162,164],{"className":163},[77,84],"turtles",[28,166,14],{"className":167},[77,78],[28,169,171],{"className":170},[77,78],"print",[28,173,176],{"className":174},[77,175],"string","\"last words?\"",", no last\nwords will be printed, because the turtles are already dead before\nthey have a chance to print anything.",[153,179,180],{},"The agent will disappear from any agentsets it was in, reducing\nthe size of those agentsets by one.",[153,182,183,184,187,188,223,224,226],{},"Any variable that was storing the agent will now instead have ",[72,185,186],{},"nobody"," in it. So for example ",[72,189,190,80,194,80,199,80,203,80,206,209,210,95,213,216,217,80,220],{},[28,191,193],{"className":192},[77,78],"let",[28,195,198],{"className":196},[77,197],"variable","x",[28,200,202],{"className":201},[77,84],"one-of",[28,204,164],{"className":205},[77,84],[28,207,113],{"className":208},[77,78],"\n ",[28,211,198],{"className":212},[77,197],[28,214,14],{"className":215},[77,78]," ] ",[28,218,171],{"className":219},[77,78],[28,221,198],{"className":222},[77,197]," prints ",[72,225,186],{},".",[153,228,229],{},"If the dead agent was a turtle, every link connected to it also\ndies.",[153,231,232,233,236],{},"If the observer was watching or following the agent, the\nobserver’s perspective resets, as if ",[72,234,235],{},"reset-perspective","had been run.",[49,238,239,240,80,253],{},"See also: ",[72,241,245],{"className":242,"displayText":244,"permalink":244},[243],"netlogo-command","clear-turtles",[21,246,244],{"className":247,"dataDisplayText":244,"href":249,"