[{"data":1,"prerenderedAt":254},["ShallowReactive",2],{"/dict/patch":3,"/dict/patch-surround":243},{"id":4,"title":5,"body":6,"description":210,"extension":211,"meta":212,"navigation":230,"path":239,"seo":240,"stem":241,"__hash__":242},"content/dict/patch.md","NetLogo Dictionary: patch",{"type":7,"value":8,"toc":199},"minimark",[9],[10,11,16,35,62,65,68,71,182],"div",{"className":12,"id":14,"role":15},[13],"dict_entry","patch","region",[17,18,20],"h3",{"id":19},"patch10",[21,22,26,27],"a",{"href":23,"role":24,"ariaLabel":25},"#patch","doc-noteref","Reference to patch","\npatch\n",[28,29,34],"span",{"className":30,"role":32,"ariaLabel":33},[31],"since","note","Since version","\n1.0\n",[36,37,41],"h4",{"id":38,"className":39},"patch-xcor-ycor",[40],"section-heading",[21,42,46],{"className":43,"href":45},[44],"section-anchor","#patch-xcor-ycor",[28,47,50],{"className":48},[49],"prim_example",[51,52,53,54,58,59],"p",{},"patch ",[55,56,57],"em",{},"xcor"," ",[55,60,61],{},"ycor",[51,63,64],{},"Given the x and y coordinates of a point, reports the patch\ncontaining that point. (The coordinates are absolute coordinates;\nthey are not computed relative to this agent, as with patch-at.)",[51,66,67],{},"If x and y are integers, the point is the center of a patch. If x\nor y is not an integer, rounding to the nearest integer is used to\ndetermine which patch contains the point.",[51,69,70],{},"If wrapping is allowed by the topology, the given coordinates will\nbe wrapped to be within the world. If wrapping is not allowed and\nthe given coordinates are outside the world, reports nobody.",[72,73,74],"pre",{},[75,76,77,58,83,58,87,58,92,96,97,58,101,58,105,110,111,114,119,121,58,125,58,128,58,132,136,138,142,144,58,147,58,150,58,154,158,160,164,166,170,172,176,178],"code",{},[28,78,82],{"className":79},[80,81],"token","command","ask",[28,84,14],{"className":85},[80,86],"reporter",[28,88,91],{"className":89},[80,90],"number","3",[28,93,95],{"className":94},[80,90],"-4"," [ ",[28,98,100],{"className":99},[80,81],"set",[28,102,104],{"className":103},[80,86],"pcolor",[28,106,109],{"className":107},[80,108],"constant","green"," ]",[112,113],"br",{},[28,115,118],{"className":116},[80,117],"comment",";; patch with pxcor of 3 and pycor of -4 turns green",[112,120],{},[28,122,124],{"className":123},[80,81],"show",[28,126,14],{"className":127},[80,86],[28,129,131],{"className":130},[80,90],"1.2",[28,133,135],{"className":134},[80,90],"3.7",[112,137],{},[28,139,141],{"className":140},[80,117],";; prints (patch 1 4); note rounding",[112,143],{},[28,145,124],{"className":146},[80,81],[28,148,14],{"className":149},[80,86],[28,151,153],{"className":152},[80,90],"18",[28,155,157],{"className":156},[80,90],"19",[112,159],{},[28,161,163],{"className":162},[80,117],";; supposing min-pxcor and min-pycor are -17",[112,165],{},[28,167,169],{"className":168},[80,117],";; and max-pxcor and max-pycor are 17,",[112,171],{},[28,173,175],{"className":174},[80,117],";; in a wrapping topology, prints (patch -17 -16);",[112,177],{},[28,179,181],{"className":180},[80,117],";; in a non-wrapping topology, prints nobody",[51,183,184,185,198],{},"See also ",[75,186,190],{"className":187,"displayText":189,"permalink":189},[188],"netlogo-command","patch-at",[21,191,189],{"className":192,"dataDisplayText":189,"href":194,"rel":195,"target":197,"title":189},[193],"netlogo-wiki-link","/dictionary#patch-at",[196],"noopener","_self",".",{"title":200,"searchDepth":201,"depth":202,"links":203},"",5,3,[204],{"id":19,"depth":202,"text":205,"children":206},"\npatch\n\n1.0\n",[207],{"id":38,"depth":208,"text":209},4,"patch xcor ycor","Documentation for the patch primitive.","md",{"source":213,"metadataOutputPath":214,"projectConfig":215,"language":222,"inheritFrom":231,"output":230,"version":216,"layout":232,"dictionaryDisplayName":233,"dictionaryHomeDirectory":234,"indexFileURI":235,"currentItemId":14,"currentItemLabel":14,"primRoot":236,"icon":237,"assetsRoot":238},"autogen/dict/patch.md