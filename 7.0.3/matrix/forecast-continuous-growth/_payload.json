le":25},[86],[88],"\n\nassumes that Y is compounded \n",[101,102,103],"strong",{},"continuously","\n (e.g., each second\nor fraction of a second). The \n",[58,106,63],{},"\n and\n\n",[58,109,67],{},"\n are the parameters of the trend-line\n",[52,112,113,114,116,117],{},"\nY = \n",[58,115,63],{},"\n * e\n",[72,118,119],{},"\n(growth-rate * t)\n",[48,121,122,129,130,137,138,140],{},[77,123,125],{"className":124,"displayText":25,"permalink":94},[80],[22,126,25],{"className":127,"dataDisplayText":25,"href":94,"rel":128,"target":89,"title":25},[86],[88],"\nis the “calculus” analog of ",[77,131,133],{"className":132,"displayText":81,"permalink":82},[80],[22,134,81],{"className":135,"dataDisplayText":81,"href":82,"rel":136,"target":89,"title":81},[86],[88],".\nThe two will normally yield similar (but not identical) results, as\nshown in the example below. ",[58,139,67],{}," may, of course, be\nnegative.",[142,143],"blockquote",{},[48,145,146,149,150,159,160,167,168,170],{},[58,147,148],{},"NOTE:"," The continuous growth forecast is achieved by taking\nthe ln of Y. (See ",[77,151,155],{"className":152,"displayText":153,"permalink":154},[80],"matrix:regress","/matrix/regress",[22,156,153],{"className":157,"dataDisplayText":153,"href":154,"rel":158,"target":89,"title":153},[86],[88],",\nbelow.) Because it is impossible to take the natural log of zero or\na negative number, ",[77,161,163],{"className":162,"displayText":25,"permalink":94},[80],[22,164,25],{"className":165,"dataDisplayText":25,"href":94,"rel":166,"target":89,"title":25},[86],[88],"\nwill result in an error if it finds a zero or negative number in\n",[58,169,46],{},".",[172,173,174],"pre",{},[77,175,176,182,185,56,190,194,195,56,200,56,204,56,208,56,212,56,216,220,221,223,194,227,56,231,56,235,56,239,220,243,245,249,251,255,257,261,263,267,269],{},[38,177,181],{"className":178},[179,180],"token","comment",";; a continuous growth extrapolation of the next item in the list.",[183,184],"br",{},[38,186,189],{"classNa