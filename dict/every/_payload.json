ll discard\ntheir timers for the “every”. The correct usage is shown\nbelow.",[106,107,108],"pre",{},[77,109,110,58,113,90,116,58,119,90,122,58,126,130,131,134,139,141,58,144,90,148,58,152,58,156,58,159,58,163,166,167,169],{},[28,111,14],{"className":112},[82,83],[28,114,97],{"className":115},[82,57],[28,117,84],{"className":118},[82,83],[28,120,89],{"className":121},[82,88],[28,123,125],{"className":124},[82,83],"fd",[28,127,129],{"className":128},[82,57],"1"," ] ]",[132,133],"br",{},[28,135,138],{"className":136},[82,137],"comment",";; twice a second the turtles will move forward 1",[132,140],{},[28,142,14],{"className":143},[82,83],[28,145,147],{"className":146},[82,57],"2",[28,149,151],{"className":150},[82,83],"set",[28,153,155],{"className":154},[82,101],"index",[28,157,155],{"className":158},[82,101],[28,160,162],{"className":161},[82,88],"+",[28,164,129],{"className":165},[82,57]," ]",[132,168],{},[28,170,172],{"className":171},[82,137],";; every 2 seconds index is incremented",[51,174,175,176,189],{},"See also ",[77,177,181],{"className":178,"displayText":180,"permalink":180},[179],"netlogo-command","wait",[21,182,180],{"className":183,"dataDisplayText":180,"href":185,"rel":186,"target":188,"title":180},[184],"netlogo-wiki-link","/dictionary#wait",[187],"noopener","_self",".",{"title":191,"searchDepth":192,"depth":193,"links":194},"",5,3,[195],{"id":19,"depth":193,"text":196,"children":197},"\nevery\n\n1.0\n",[198],{"id":38,"depth":199,"text":200},4,"every number  commands","Documentation for the every primitive.","md",{"source":204,"metadataOutputPath":205,"projectConfig":206,"language":213,"inheritFrom":222,"output":221,"version":207,"layout":223,"dictionaryDisplayName":224,"dictionaryHomeDirectory":225,"indexFileURI":226,"currentItemId":14,"currentItemLabel":14,"primRoot":227,"icon":228,"assetsRoot":229},"autogen/dict/every.md","content/dict/every.metadata.yaml",{"version":207,"projectRoot":189,"scanRoot":208,"outputRoot":209,"defaults":210,"engine":216,