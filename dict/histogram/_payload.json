(either directly with ",[74,90,93],{"className":91,"displayText":92,"permalink":92},[77],"set-plot-pen-interval",[21,94,92],{"className":95,"dataDisplayText":92,"href":96,"rel":97,"target":87,"title":92},[83],"/dictionary#set-plot-pen-interval",[86],", or indirectly via ",[74,100,103],{"className":101,"displayText":102,"permalink":102},[77],"set-histogram-num-bars",[21,104,102],{"className":105,"dataDisplayText":102,"href":106,"rel":107,"target":87,"title":102},[83],"/dictionary#set-histogram-num-bars",[86],") to\ncontrol how many bars that range is split up into.",[51,110,111],{},"Be sure that if you want the histogram drawn with bars that the\ncurrent pen is in bar mode (mode 1).",[51,113,114],{},"For histogramming purposes the plot’s X range is not considered\nto include the maximum X value. Values equal to the maximum X will\nfall outside of the histogram’s range.",[116,117,118],"pre",{},[74,119,120,125,126,131,132,136,137,141,144,149,151],{},[28,121,14],{"className":122},[123,124],"token","command"," [",[28,127,130],{"className":128},[123,129],"reporter","color","] ",[28,133,135],{"className":134},[123,129],"of"," ",[28,138,140],{"className":139},[123,129],"turtles",[142,143],"br",{},[28,145,148],{"className":146},[123,147],"comment",";; draws a histogram showing how many turtles there are",[142,150],{},[28,152,154],{"className":153},[123,147],";; of each color",[51,156,157],{},"This command will produce a runtime error if either the current plot or the current\npen has not been set.",[51,159,160,161,168,169,168,176,183],{},"See also ",[74,162,164],{"className":163,"displayText":102,"permalink":102},[77],[21,165,102],{"className":166,"dataDisplayText":102,"href":106,"rel":167,"target":87,"title":102},[83],[86],", ",[74,170,172],{"className":171,"displayText":92,"permalink":92},[77],[21,173,92],{"className":174,"dataDisplayText":92,"href":96,"rel":175,"target":87,"title":92},[83],[86],[74,177,179],{"className":178,"displayText":78,"permalink":79},[77],[21,180,78