[{"data":1,"prerenderedAt":182},["ShallowReactive",2],{"/dict/import-world":3,"/dict/import-world-surround":171},{"id":4,"title":5,"body":6,"description":138,"extension":139,"meta":140,"navigation":158,"path":167,"seo":168,"stem":169,"__hash__":170},"content/dict/import-world.md","NetLogo Dictionary: import-world",{"type":7,"value":8,"toc":127},"minimark",[9],[10,11,16,35,58,77,80,83,106,117],"div",{"className":12,"id":14,"role":15},[13],"dict_entry","import-world","region",[17,18,20],"h3",{"id":19},"import-world10",[21,22,26,27],"a",{"href":23,"role":24,"ariaLabel":25},"#import-world","doc-noteref","Reference to import-world","\nimport-world\n",[28,29,34],"span",{"className":30,"role":32,"ariaLabel":33},[31],"since","note","Since version","\n1.0\n",[36,37,41],"h4",{"id":38,"className":39},"import-world-filename",[40],"section-heading",[21,42,46],{"className":43,"href":45},[44],"section-anchor","#import-world-filename",[28,47,50],{"className":48},[49],"prim_example",[51,52,53,54],"p",{},"import-world ",[55,56,57],"em",{},"filename",[51,59,60,61,76],{},"Reads the values of all variables for a model, both built-in and\nuser-defined, including all observer, turtle, and patch variables,\nfrom an external file named by the given string. The file should be\nin the format used by the ",[62,63,68],"code",{"className":64,"displayText":66,"permalink":67},[65],"netlogo-command","export-world","export-cmds",[21,69,66],{"href":70,"rel":71,"className":73,"dataDisplayText":66,"target":75,"title":66},"/dictionary#export-cmds",[72],"noopener",[74],"netlogo-wiki-link","_self","primitive.",[51,78,79],{},"Note that the functionality of this primitive is also directly\navailable from NetLogo’s File menu.",[51,81,82],{},"When using import-world, to avoid errors, perform these steps in\nthe following order:",[84,85,86,90,93,96,103],"ol",{},[87,88,89],"li",{},"Open the model from which you created the export file.",[87,91,92],{},"Press the Setup button, to get the model in a state from which\nit can be run.",[87,94,95],{},"Import the file.",[87,97,98,99,102],{},"Re-open any files that the model had opened with the ",[62,100,101],{},"file-open"," command.",[87,104,105],{},"If you want, press Go button to continue running the model from\nthe point where it left off.",[51,107,108,109,116],{},"If you wish to import a file from a location other than the\nmodel’s location, you may include the full path to the file you\nwish to import. See ",[62,110,112],{"className":111,"displayText":66,"permalink":67},[65],[21,113,66],{"href":70,"rel":114,"className":115,"dataDisplayText":66,"target":75,"title":66},[72],[74]," for an\nexample.",[51,118,119,120,126],{},"Note: This primitive is not compatible with NetLogo Web. If you\nwish to import a world with the same code and the\nsame behavior in both NetLogo and NetLogo Web, see ",[21,121,125],{"href":122,"rel":123},"https://github.com/NetLogo/ImportA-Extension#readme",[124],"nofollow","import-a:world",".",{"title":128,"searchDepth":129,"depth":130,"links":131},"",5,3,[132],{"id":19,"depth":130,"text":133,"children":134},"\nimport-world\n\n1.0\n",[135],{"id":38,"depth":136,"text":137},4,"import-world filename","Documentation for the import-world primitive.","md",{"source":141,"metadataOutputPath":142,"projectConfig":143,"language":150,"inheritFrom":159,"output":158,"version":144,"layout":160,"dictionaryDisplayName":161,"dictionaryHomeDirectory":162,"indexFileURI":163,"currentItemId":14,"currentItemLabel":14,"primRoot":164,"icon":165,"assetsRoot":166},"autogen/dict/import-world.md","content/dict/import-world.metadata.yaml",{"version":144,"projectRoot":126,"scanRoot":145,"outputRoot":146,"defaults":147,"engine":153,"partials":154,"dedupeIdenticalDiskWrites":158},"7.0.3","autogen","content",{"inheritFrom":148,"language":150,"output":151,"extension":139,"title":152,"version":144},[149],0,"en",false,"NetLogo User Manual","handlebars",{"directoryPaths":155,"extensions":156},[126],[157,139],"mustache",true,[149],"catalog","N